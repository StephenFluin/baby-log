{
  "name": "baby-log",
  "version": "0.0.0",
  "scripts": {
    "preserve": "node scripts/update-build-info.ts",
    "serve": "ng serve",
    "prebuild": "node scripts/update-build-info.ts",
    "build": "ng build",
    "deploy": "npm run build && firebase deploy --only hosting:baby-log,database",
    "pretest": "node scripts/update-build-info.ts",
    "test": "ng test --watch=false",
    "test:rules": "firebase emulators:exec --only database --project demo-baby-log \"vitest run --config tests/vitest.config.mts\"",
    "pree2e": "node scripts/update-build-info.ts",
    "e2e": "firebase emulators:exec --only auth,database --project demo-baby-log \"playwright test\""
  },
  "private": true,
  "engines": {
    "node": "^22.22.3 || >=24.15.0"
  },
  "dependencies": {
    "@angular/cdk": "^22.2.2",
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/forms": "^22.2.2",
    "@angular/material": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "@angular/router": "^22.2.2",
    "date-fns": "^4.4.0",
    "firebase": "^13.0.0",
    "ngx-mat-timepicker": "^22.1.0",
    "rxjs": "^7.8.1",
    "tslib": "^2.0.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.2",
    "@angular/language-service": "^22.2.2",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.0",
    "firebase-tools": "^15.33.0",
    "jsdom": "^30.1.2",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4"
  },
  "prettier": {
    "trailingComma": "es5",
    "tabWidth": 4,
    "singleQuote": true,
    "printWidth": 100
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6",
    "basic-ftp": "^6.2.3",
    "gaxios": {
      "uuid": "^11.1.1"
    }
  }
}
